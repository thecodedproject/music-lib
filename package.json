{
  "name": "music-lib",
  "version": "0.1.1",
  "description": "Music theory, notation rendering and audio shared by the codedproject music apps",
  "license": "MIT",
  "packageManager": "yarn@1.22.21",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theory": {
      "types": "./dist/esm/theory/index.d.ts",
      "import": "./dist/esm/theory/index.js",
      "require": "./dist/cjs/theory/index.js"
    },
    "./audio": {
      "types": "./dist/esm/audio/index.d.ts",
      "import": "./dist/esm/audio/index.js",
      "require": "./dist/cjs/audio/index.js"
    },
    "./react": {
      "types": "./dist/esm/react/index.d.ts",
      "import": "./dist/esm/react/index.js",
      "require": "./dist/cjs/react/index.js"
    },
    "./react/stave.css": "./dist/esm/react/stave.css"
  },
  "typesVersions": {
    "*": {
      "theory": [
        "dist/esm/theory/index.d.ts"
      ],
      "audio": [
        "dist/esm/audio/index.d.ts"
      ],
      "react": [
        "dist/esm/react/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --module commonjs --declaration false --outDir dist/cjs && cp src/react/*.css dist/esm/react/ && cp src/react/*.css dist/cjs/react/ && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.3.1",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
