{
  "compilerOptions": {
    "outDir": "./dist/",
    "rootDir": "./src",
    "declaration": true,
    "noImplicitAny": true,
    "module": "es6",
    "target": "es2019",
    "lib": ["es2019", "dom"],
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
